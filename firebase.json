{
  "hosting": {
    "public": ".",
    "rewrites": [
      {
        "source": "/api/ren-clone",
        "function": "renClone"
      }
    ],
    "ignore": [
      "firebase.json",
      "firebase.deploy.json",
      "SECURE_CONTACT_DEPLOY.md",
      "functions/**",
      "print-exports/**",
      "ren-zihan-name-card.html",
      "ren-zihan-name-card-preview.png",
      ".github/**",
      "deploy.log",
      "firebase-debug.log",
      "**/*.log",
      "**/.*",
      "**/.firebase/**",
      "**/.git/**",
      "**/node_modules/**"
    ],
    "cleanUrls": true,
    "trailingSlash": false
  }
}

{
  "functions": {
    "source": "functions-renclone"
  },
  "hosting": {
    "public": ".",
    "rewrites": [
      {
        "source": "/api/ren-clone",
        "function": "renclone"
      },
      {
        "source": "/api/ren-clone-live",
        "function": "renCloneLive"
      }
    ],
    "headers": [
      {
        "source": "/demo",
        "headers": [
          {
            "key": "X-Robots-Tag",
            "value": "noindex, nofollow"
          }
        ]
      },
      {
        "source": "/demo/**",
        "headers": [
          {
            "key": "X-Robots-Tag",
            "value": "noindex, nofollow"
          }
        ]
      }
    ],
    "ignore": [
      "firebase.json",
      "firebase.deploy.json",
      "SECURE_CONTACT_DEPLOY.md",
      "functions/**",
      "functions-renclone/**",
      "docs/**",
      "print-exports/**",
      "ren-zihan-name-card.html",
      "ren-zihan-name-card-preview.png",
      ".github/**",
      "deploy.log",
      "firebase-debug.log",
      "**/*.log",
      "**/.*",
      "**/.firebase/**",
      "**/.git/**",
      "**/node_modules/**"
    ],
    "cleanUrls": true,
    "trailingSlash": false
  }
}
